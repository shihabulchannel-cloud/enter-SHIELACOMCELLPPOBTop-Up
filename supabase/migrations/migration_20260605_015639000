
-- ============================================================
-- SHIELACOM CELL - Full Transaction System Tables
-- ============================================================

-- Products table
CREATE TABLE IF NOT EXISTS sc_products (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  sku text UNIQUE NOT NULL,
  name text NOT NULL,
  category_id text NOT NULL DEFAULT 'pulsa',
  brand text DEFAULT '',
  description text DEFAULT '',
  buy_price integer NOT NULL DEFAULT 0,
  sell_price integer NOT NULL DEFAULT 0,
  active boolean DEFAULT true,
  provider text DEFAULT 'digiflazz',
  provider_code text DEFAULT '',
  created_at timestamptz DEFAULT now(),
  updated_at timestamptz DEFAULT now()
);

ALTER TABLE sc_products ENABLE ROW LEVEL SECURITY;

CREATE POLICY "public_read_active_products"
  ON sc_products FOR SELECT
  USING (active = true);

CREATE POLICY "service_role_all_products"
  ON sc_products
  USING (true)
  WITH CHECK (true);

-- Orders table
CREATE TABLE IF NOT EXISTS sc_orders (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  invoice_id text UNIQUE NOT NULL,
  product_sku text NOT NULL,
  product_name text NOT NULL,
  product_price integer NOT NULL DEFAULT 0,
  buyer_name text NOT NULL DEFAULT '',
  buyer_email text DEFAULT '',
  buyer_whatsapp text DEFAULT '',
  target text NOT NULL DEFAULT '',
  target_detail text DEFAULT '',
  payment_method text DEFAULT '',
  payment_gateway text DEFAULT '',
  payment_amount integer NOT NULL DEFAULT 0,
  payment_fee integer DEFAULT 0,
  payment_status text DEFAULT 'pending',
  payment_code text DEFAULT '',
  payment_url text DEFAULT '',
  order_status text DEFAULT 'waiting_payment',
  digiflazz_ref text DEFAULT '',
  digiflazz_sn text DEFAULT '',
  notes text DEFAULT '',
  created_at timestamptz DEFAULT now(),
  updated_at timestamptz DEFAULT now(),
  expired_at timestamptz DEFAULT (now() + interval '1 hour')
);

ALTER TABLE sc_orders ENABLE ROW LEVEL SECURITY;

CREATE POLICY "public_insert_orders"
  ON sc_orders FOR INSERT
  WITH CHECK (true);

CREATE POLICY "public_read_orders"
  ON sc_orders FOR SELECT
  USING (true);

CREATE POLICY "service_role_update_orders"
  ON sc_orders FOR UPDATE
  USING (true);

-- Payment gateway configs
CREATE TABLE IF NOT EXISTS sc_payment_configs (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  gateway text UNIQUE NOT NULL,
  config_json jsonb DEFAULT '{}',
  active boolean DEFAULT false,
  updated_at timestamptz DEFAULT now()
);

ALTER TABLE sc_payment_configs ENABLE ROW LEVEL SECURITY;

CREATE POLICY "service_role_payment_configs"
  ON sc_payment_configs
  USING (true)
  WITH CHECK (true);

-- Digiflazz config
CREATE TABLE IF NOT EXISTS sc_digiflazz_config (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  username text DEFAULT '',
  api_key text DEFAULT '',
  webhook_secret text DEFAULT '',
  active boolean DEFAULT false,
  updated_at timestamptz DEFAULT now()
);

ALTER TABLE sc_digiflazz_config ENABLE ROW LEVEL SECURITY;

CREATE POLICY "service_role_digiflazz_config"
  ON sc_digiflazz_config
  USING (true)
  WITH CHECK (true);

