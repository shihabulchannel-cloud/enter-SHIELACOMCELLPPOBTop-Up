ON CONFLICT (id) DO NOTHING;

-- Storage RLS policies
CREATE POLICY "anon_read_cms_media_storage"
  ON storage.objects FOR SELECT
  USING (bucket_id = 'cms-media');

CREATE POLICY "anon_upload_cms_media_storage"
  ON storage.objects FOR INSERT
  WITH CHECK (bucket_id = 'cms-media');

CREATE POLICY "anon_delete_cms_media_storage"
  ON storage.objects FOR DELETE
  USING (bucket_id = 'cms-media');

-- ============================================================
-- Updated_at trigger
-- ============================================================
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS set_cms_categories_updated_at ON sc_cms_categories;
CREATE TRIGGER set_cms_categories_updated_at
  BEFORE UPDATE ON sc_cms_categories
  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
