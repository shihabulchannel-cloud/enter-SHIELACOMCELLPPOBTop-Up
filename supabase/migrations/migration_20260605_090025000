-- ============================================================
-- LEGAL PAGES + COMPANY INFO MIGRATION
-- Safe: only adds new tables, does NOT touch existing tables
-- ============================================================

-- 1. Legal pages content
CREATE TABLE IF NOT EXISTS sc_legal_pages (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  page_key text UNIQUE NOT NULL,
  title text NOT NULL DEFAULT '',
  content text NOT NULL DEFAULT '',
  last_updated date DEFAULT CURRENT_DATE,
  updated_at timestamptz DEFAULT now()
);
ALTER TABLE sc_legal_pages ENABLE ROW LEVEL SECURITY;
CREATE POLICY "public_read_legal" ON sc_legal_pages FOR SELECT TO public USING (true);
CREATE POLICY "service_role_legal" ON sc_legal_pages FOR ALL TO public USING (true) WITH CHECK (true);

-- 2. Company / store info
CREATE TABLE IF NOT EXISTS sc_company_info (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  business_name text DEFAULT 'SHIELACOM CELL',
  address text DEFAULT '',
  city text DEFAULT '',
  province text DEFAULT '',
  postal_code text DEFAULT '',
  whatsapp text DEFAULT '',
  email text DEFAULT '',
  operating_hours text DEFAULT 'Senin-Minggu: 08.00 - 22.00 WIB',
  maps_url text DEFAULT '',
  updated_at timestamptz DEFAULT now()
);
ALTER TABLE sc_company_info ENABLE ROW LEVEL SECURITY;
CREATE POLICY "public_read_company" ON sc_company_info FOR SELECT TO public USING (true);
CREATE POLICY "service_role_company" ON sc_company_info FOR ALL TO public USING (true) WITH CHECK (true);

