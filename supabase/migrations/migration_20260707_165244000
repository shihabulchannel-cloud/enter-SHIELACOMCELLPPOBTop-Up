-- Restorasi anon READ untuk tabel yang dibutuhkan admin panel
-- (writes tetap restricted ke service_role via admin-api Edge Function)

-- Products: anon bisa baca SEMUA produk (termasuk nonaktif, untuk admin panel)
CREATE POLICY "anon_read_all_products" ON sc_products
  FOR SELECT TO anon USING (true);

-- Digiflazz config: anon bisa baca (admin panel perlu ini)
CREATE POLICY "anon_read_digiflazz_config" ON sc_digiflazz_config
  FOR SELECT TO anon USING (true);

-- Payment configs: anon bisa baca SEMUA (termasuk yang nonaktif, untuk admin)
DROP POLICY IF EXISTS "anon_read_payment_configs" ON sc_payment_configs;
CREATE POLICY "anon_read_payment_configs" ON sc_payment_configs
  FOR SELECT TO anon USING (true);
